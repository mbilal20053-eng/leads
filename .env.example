# =============================================================================
# Lead Engine PRO - Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit real secret keys, tokens, or credentials into Git.
# =============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Local Storage Root (Default: d:/leads for local Windows development)
# In production, set to a persistent mounted volume path (e.g. /data or /mnt/leads)
LEADS_DATA_DIR=d:/leads

# Maximum Upload Size in Bytes (Default: 104,857,600 bytes = 100 MB)
MAX_CONTENT_LENGTH=104857600

# -----------------------------------------------------------------------------
# Production Cloud Storage Backend (Optional - For Cloud / Netlify Deployment)
# -----------------------------------------------------------------------------
# Options: local | s3 | r2 | supabase
STORAGE_BACKEND=local

# S3 / Cloudflare R2 / MinIO Object Storage (Used if STORAGE_BACKEND=s3 or r2)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Production Cloud Database (Optional - For Serverless / External Persistence)
# -----------------------------------------------------------------------------
# MotherDuck (Cloud DuckDB): md:my_leads_db?motherduck_token=YOUR_TOKEN
# Or PostgreSQL / Supabase: postgresql://user:password@host:5432/dbname
DATABASE_URL=
MOTHERDUCK_TOKEN=

# Netlify Deployment API Proxy (Configured in Netlify Dashboard for frontend)
BACKEND_URL=
